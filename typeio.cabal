cabal-version:      3.0
name:               typeio 
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             jordanstorz
maintainer:         jm.storz@gmail.com
-- copyright:
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable server 
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    
      base ^>=4.18.3.0
      , src 
    hs-source-dirs:   exe/server
    default-language: Haskell2010

library src 
    import:
      warnings
    exposed-modules:
      Platform.Web
      , Common.Validation
      , Config.App
      , Config.Db
      , Config.Web
      , Data.Either
      , Data.HashTree
      , Data.Text.Util
      -- Exposed (rather than other-modules) specifically so the
      -- `integration` test-suite can import them -- a cabal test-suite
      -- only sees a library's exposed-modules, never its other-modules
      -- (see CLAUDE.md's notes on this from the unit-testing rollout).
      , Domain.Central.Responder.Api.Seed
      , Domain.Project.Model
      , Domain.Project.Responder.Api.Node.Post
      , Domain.Project.Responder.Ui.ProjectCreate.Submit
      , Environment.Db
    other-modules:
      Common.Web.Attributes
      , Common.Web.Elements
      , Common.Web.Query
      , Common.Web.Template.MainHeader
      , Container.Build
      , Container.Root
      , Domain.Central.Container
      , Domain.Central.Responder.Ui.Empty
      , Domain.Central.Responder.Ui.IndexView
      , Domain.Central.Responder.Ui.Container
      , Domain.Central.Responder.Api.Container
      , Domain.Central.Middleware.IndexRender
      , Domain.Project.Container
      , Domain.Project.Responder.Api.Node.Get
      , Domain.Project.Responder.Api.NodeStatus.Get
      , Domain.Project.Responder.Api.NodeType.Get
      , Domain.Project.Responder.Api.Project.Get
      , Domain.Project.Responder.Api.Container
      , Domain.Project.Responder.Ui.Container
      , Domain.Project.Responder.Ui.ProjectManage.Graph
      , Domain.Project.Responder.Ui.ProjectManage.Link
      , Domain.Project.Responder.Ui.ProjectManage.Node
      , Domain.Project.Responder.Ui.ProjectManage.Node.Description
      , Domain.Project.Responder.Ui.ProjectManage.Node.Detail
      , Domain.Project.Responder.Ui.ProjectManage.Node.Edit
      , Domain.Project.Responder.Ui.ProjectManage.Node.Query
      , Domain.Project.Responder.Ui.ProjectManage.Node.Refresh
      , Domain.Project.Responder.Ui.ProjectManage.Node.Status
      , Domain.Project.Responder.Ui.ProjectManage.Node.Title
      , Domain.Project.Responder.Ui.ProjectManage.Node.Validation
      , Domain.Project.Responder.Ui.ProjectManage.View
      , Domain.Project.Responder.Ui.ProjectCreate.View
      , Domain.Project.Responder.Ui.ProjectIndex.List
      , Domain.Project.Responder.Ui.ProjectIndex.View
      , Domain.System.Container
      , Domain.System.Middleware.Container
      , Domain.System.Responder.Container
      , Domain.System.Responder.Config
      , Domain.System.Middleware.RequestId
      , Domain.System.Middleware.Logging.Common
      , Domain.System.Middleware.Logging.Request
      , Domain.System.Middleware.Logging.Response
      , Logging.Core
      , Logging.Database
      , Environment.Env
      , Environment.Logging
      , Platform.Web.Router
      , Platform.Web.Middleware
    other-extensions:
      OverloadedStrings
    build-depends:    
      aeson 
      , base ^>=4.18.3.0
      , bytestring
      , case-insensitive
      , clay
      , containers
      , dotenv
      , esqueleto
      , fast-logger
      , hashable
      , http-types
      , lucid2
      , lucid-svg
      , mtl
      , monad-logger
      , network-uri 
      , persistent
      , persistent-postgresql
      , persistent-template
      , postgresql-simple
      , resource-pool
      , time
      , text
      , transformers
      , transformers-base
      , transformers-either
      , unliftio-core
      , unordered-containers
      , uuid
      , wai
      , wai-extra
      , wai-middleware-static
      , wai-util
      , warp
    hs-source-dirs:   lib/src
    default-language: Haskell2010

test-suite spec
    import:             warnings
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test
    other-modules:
      Common.ValidationSpec
      , Config.AppSpec
      , Config.DbSpec
      , Config.WebSpec
      , Data.EitherSpec
      , Data.HashTreeSpec
      , Data.Text.UtilSpec
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
      base ^>=4.18.3.0
      , src
      , bytestring
      , case-insensitive
      , hashable
      , hspec
      , mtl
      , QuickCheck
      , text
    default-language:   Haskell2010

-- Separate from `spec` on purpose (docs/solution-proposals/integration-testing.md
-- §7): these tests need Docker (via testcontainers) and a real, migrated
-- Postgres, so they're a distinct, slower `cabal test integration` target
-- rather than something that runs every time plain `cabal test` does.
test-suite integration
    import:             warnings
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test-integration
    other-modules:
      Integration.Support
      , Domain.Project.Responder.Api.Node.PostSpec
      , Domain.Project.Responder.Ui.ProjectCreate.SubmitSpec
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
      base ^>=4.18.3.0
      , src
      , bytestring
      , directory
      , http-types
      , hspec
      , mtl
      , persistent
      , testcontainers
      , text
      , time
      , transformers
      , wai
      , wai-extra
    default-language:   Haskell2010
